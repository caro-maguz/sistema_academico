# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.
# Sin MONGODB_URI el servidor usa datos en memoria (se pierden al reiniciar).
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/
DB_NAME=siga
PORT=4000
# Secreto para firmar las sesiones: texto aleatorio de al menos 32 caracteres.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
